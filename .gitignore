# Build artefacts
*.elf
*.hex
*.map
*.o
*.d
*.bak
memoryfile.xml
setup_verify.elf

# MPLAB X build output
adc_dma_40msps.X/build/
adc_dma_40msps.X/dist/
adc_dma_40msps.X/debug/
adc_dma_40msps.X/.generated_files/

# MPLAB X generated makefile fragments and per-user settings.
#
# These are DERIVED from nbproject/configurations.xml (which IS tracked) and
# they contain absolute paths of the machine that generated them, e.g.
#   C:\Program Files\Microchip\xc-dsc\v3.21\bin
#   C:/Program Files/Microchip/MPLABX/v6.35/packs/...
# Committed, they would be wrong on every other machine - and wrong in the
# expensive way: the build starts, then fails on a missing tool.
#
# Opening the project in MPLAB X recreates them. No IDE session is needed to
# get them either: MPLAB X ships prjMakefilesGenerator.bat for exactly this
# (see tools/_test_mplabx.bat).
adc_dma_40msps.X/nbproject/Makefile-*.mk
adc_dma_40msps.X/nbproject/Makefile-genesis.properties
adc_dma_40msps.X/nbproject/private/

# Command-line build output (tools/build.bat)
build/

# The GUI's private Python environment (tools/gui_setup.bat creates it)
tools/.venv/
__pycache__/

# Generated by tools/version.bat / version.sh before every build (git revision
# for the banner): src/app/version.h, next to board.h which includes it. The
# pattern has no slash, so it matches there and anywhere else it might land.
version.h
version.h.tmp

# The GUI's own settings (tools/adc_gui.py "save"): personal state, not the
# standard. The standard is tools/adc_gui_defaults.json (tracked).
tools/adc_gui_settings.json

# board_run/ (BR.4) is the one deliberate exception to "*.hex" above: its
# hex files are committed prebuilt firmware images for the colleague's
# board run, not build output of the current tree (board_run/README.md).
!board_run/
!board_run/*.hex
