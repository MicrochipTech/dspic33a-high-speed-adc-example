flowchart LR

    ST["<b>Self-test first</b><br/>AD3AN6 = internal 15/16·VDD<br/>mean of a half must be ≈ 3840<br/>then switch to AD3AN5"] --> BUFS
    BUFS["buf[2048]<br/>one half is filling,<br/>the other is complete"] == "HALF or DONE flag" ==> ISR["<b>DMA0 ISR</b> (priority 4)<br/>clear flags by writing 0<br/>note which half is ready<br/>at DONE: start the next ADC burst"]
    ISR --> PROC["<b>main()</b><br/>process_buffer() on the complete half<br/>heartbeat on LED0 (RC8)"]
    UART[("<b>UART1 RX ISR</b> (priority 1)<br/>cmd_parser: status, start, stop,<br/>samc, input, selftest, stats,<br/>dump, clear, led, reset")] -. "PKOB4 COM port<br/>115200 8N1" .-> PC(["terminal or script<br/>ACK / NAK after every line"])
    UART -. "reads counters,<br/>sets input/samc between bursts" .-> ISR
    PROC --> CNT[["<b>What to read (debugger or 'status')</b><br/>blocks × 1024 / time = actual rate<br/><b>overrun</b> → must stay 0<br/><b>late</b>, <b>missed</b> → must stay 0<br/>selftest_mean ≈ 3840, fail_code = 0"]]
    CNT --> ANS(["<b>The question this answers:</b><br/>3 ch × 40 MSPS × 2 B = 240 MB/s<br/>5 ch = 400 MB/s<br/>over that one bus —<br/>the datasheet gives no figure"])

